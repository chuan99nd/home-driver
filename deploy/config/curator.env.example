# /etc/home-driver/curator.env  (mode 0600, owner root)
# Settings for the photo curator (home-driver-curator.service and the nightly
# home-driver-curator-scan.service).
#
# NOTE FOR CONTRIBUTORS: the authoritative list of CURATOR_* variables is in
# curator/CLAUDE.md. When a variable is added there, add it here with a comment.
#
# Format rules: one KEY=value per line, no spaces around "=", no comments after a value.

# Address the curator listens on. Must stay on 127.0.0.1: the curator has no
# login of its own and is only reached through Drive at /curator/.
CURATOR_ADDR=127.0.0.1:8091

# SQLite database with the review queue, on the internal SSD.
CURATOR_DB_PATH=/var/lib/home-driver/curator/curator.db

# Where the curator reaches Immich on this machine.
CURATOR_IMMICH_URL=http://127.0.0.1:2283

# An Immich API key. Create it in Immich: click your avatar > Account Settings >
# API Keys > New API Key. Use an administrator account.
CURATOR_IMMICH_API_KEY=

# The public address of Immich, used for "open in Immich" links in the review
# screens. Leave empty to hide those links.
CURATOR_IMMICH_PUBLIC_URL=https://photos.example.com

# Practice mode. While "on", pressing "Move to trash" changes nothing in Immich,
# so you can look at the suggestions safely first. Recommended for the first
# week: check the suggestions make sense (and run
#   /opt/home-driver/curator/.venv/bin/home-driver-curator doctor --sample 500
# to see how your library scores), then set this to "off".
CURATOR_DRY_RUN=on

# How many photos one nightly scan analyses at most. A large library is worked
# through over several nights.
CURATOR_SCAN_BATCH=5000

# Script used to send the "new suggestions" alert.
CURATOR_NOTIFY_SCRIPT=/opt/home-driver/scripts/notify.sh

# --- Advanced tuning (leave commented out to use the built-in defaults) ---
# The defaults and what each value means are documented in curator/CLAUDE.md.
# Turn single detectors off:
#CURATOR_DETECT_BLURRY=off
#CURATOR_DETECT_DARK=off
#CURATOR_DETECT_SCREENSHOT=off
#CURATOR_DETECT_BURST=off
#CURATOR_DETECT_DUPLICATES=off
# Detector sensitivity:
#CURATOR_BLUR_THRESHOLD=
#CURATOR_DARK_THRESHOLD=
#CURATOR_SCREENSHOT_THRESHOLD=
#CURATOR_BURST_WINDOW_SECONDS=
#CURATOR_BURST_HAMMING=
# Scan pacing and Immich connection:
#CURATOR_SCAN_PAGE_SIZE=
#CURATOR_SCAN_CONCURRENCY=
#CURATOR_SCAN_SLEEP_MS=
#CURATOR_IMMICH_TIMEOUT=
#CURATOR_IMMICH_RETRIES=
