# /etc/home-driver/backup.env  (mode 0600, owner root)
# Settings for backup-local.sh, backup-offsite.sh, scrub.sh, smart-check.sh, doctor.sh.
# The defaults are sensible: you can leave everything as is for local backups.
#
# Format rules: one KEY=value per line, no spaces around "=", no comments after a value.

# ---- Local backup: Disk A -> Disk B, every night ----

# How many read-only snapshots to keep on Disk B. A snapshot is how you get back
# a file that was deleted or overwritten by mistake.
# DAILY: every snapshot from the newest N days is kept.
# WEEKLY / MONTHLY: the newest snapshot of each of the last N weeks / months.
# With the defaults you can go back day by day for two weeks, week by week for
# two months, and month by month for a year.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# How many database dumps of each kind to keep in /var/lib/home-driver/dumps.
BACKUP_DUMP_KEEP=7

# Safety brake. If the nightly sync would delete more than this percentage of the
# files in the backup copy, the backup stops and alerts you instead (something
# probably went wrong on Disk A). After checking, run once by hand with:
#   sudo /opt/home-driver/scripts/backup-local.sh --allow-mass-delete
# 0 disables the brake (not recommended).
BACKUP_MAX_DELETE_PERCENT=20

# Which databases to dump before each backup. Set to 0 ONLY for a component you
# do not run; a missing database is otherwise reported as an error every night.
BACKUP_IMMICH_DB=1
BACKUP_DRIVE_DB=1
BACKUP_CURATOR_DB=1

# Name of the Immich Postgres container. Only change it if you renamed the
# container in the compose file.
# BACKUP_IMMICH_DB_CONTAINER=immich_postgres

# ---- Health thresholds (doctor.sh) ----
# doctor.sh reports a problem if the last successful local backup is older than this.
BACKUP_MAX_AGE_HOURS=36
# Disk usage percentages for a warning and for a failure.
BACKUP_DISK_WARN_PERCENT=80
BACKUP_DISK_FAIL_PERCENT=92

# ---- SMART (smart-check.sh) ----
# How smartctl talks to the USB enclosure: auto (try plain, then "sat"), or a
# smartctl -d type such as sat, usbjmicron, usbsunplus. Leave auto unless
# `sudo smartctl -a /dev/sdX` only works with a specific -d option.
BACKUP_SMART_DEVICE_TYPE=auto

# ---- Offsite backup with restic (OPTIONAL, encrypted) ----
# Leave RESTIC_REPOSITORY empty to disable: backup-offsite.sh then exits cleanly.
# These are restic's own variable names, passed straight to restic.
# Examples:
#   Backblaze B2 (S3 API): s3:https://s3.us-west-004.backblazeb2.com/my-bucket/home-driver
#   Any S3:                s3:https://s3.amazonaws.com/my-bucket/home-driver
#   Another computer:      sftp:user@host:/backups/home-driver
RESTIC_REPOSITORY=

# Encryption password for the offsite backup. WRITE IT DOWN ON PAPER and keep it
# away from the laptop: without it the offsite backup cannot be read by anyone,
# including you. A copy inside the backup itself does not help.
RESTIC_PASSWORD=

# Credentials for S3-compatible storage (Backblaze B2 "application key" = these two).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Offsite retention (restic forget --prune).
BACKUP_OFFSITE_KEEP_DAILY=7
BACKUP_OFFSITE_KEEP_WEEKLY=4
BACKUP_OFFSITE_KEEP_MONTHLY=12

# Run `restic check` (verifies the repository structure) when the last check is
# older than this many days.
BACKUP_OFFSITE_CHECK_DAYS=7
# Optionally also re-download and verify part of the data on each check, e.g. 2%.
# Costs download traffic. Empty = structure check only.
BACKUP_OFFSITE_CHECK_READ_SUBSET=

# 1 = do not upload Immich thumbnails and transcoded videos (they can be
# regenerated from the originals; saves a lot of cloud storage). 0 = upload everything.
BACKUP_OFFSITE_EXCLUDE_GENERATED=1

# Upload speed limit in KiB/s so the nightly upload does not choke the home
# connection. Empty = unlimited.
BACKUP_OFFSITE_UPLOAD_LIMIT_KBPS=
