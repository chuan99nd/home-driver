[Unit]
Description=home-driver: nightly curator scan of the Immich library
Documentation=file:///opt/home-driver/docs/RUNBOOK.md
After=network-online.target home-driver-immich.service
Wants=network-online.target
AssertPathExists=/etc/home-driver/curator.env
OnFailure=home-driver-notify-failure@%n.service

[Service]
Type=oneshot
User=home-driver
Group=home-driver
EnvironmentFile=/etc/home-driver/common.env
EnvironmentFile=/etc/home-driver/curator.env
Environment=HOME=/var/lib/home-driver/curator
Environment=XDG_CACHE_HOME=/var/lib/home-driver/curator/cache
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/home-driver/curator/.venv/bin/home-driver-curator scan
TimeoutStartSec=6h
Nice=10
# --- hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=/var/lib/home-driver/curator
