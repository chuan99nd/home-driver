# /etc/home-driver/common.env  (mode 0600, owner root)
# Shared settings, read by every home-driver service and script.
#
# Format rules: one KEY=value per line, no spaces around "=", no comments after
# a value. Put values that contain spaces in "double quotes".

# Your domain. Immich is served at photos.<HD_DOMAIN>, Drive at drive.<HD_DOMAIN>.
HD_DOMAIN=example.com

# ---- Notifications (alerts when a backup fails, a disk is missing or failing) ----
# How alerts reach your phone: telegram, ntfy, or empty to disable.
# With this empty the server CANNOT tell you when something breaks. Set it up.
NOTIFY_METHOD=

# Telegram: create a bot by talking to @BotFather in Telegram, it gives you a token
# like 123456789:AAE... . Then send any message to your new bot and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your numeric chat id.
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# ntfy: install the ntfy app, subscribe to a long random topic name, and put the
# full topic URL here, e.g. https://ntfy.sh/home-driver-7f3k9x2m4q . Anyone who
# knows the URL can read the alerts, so make the topic name unguessable.
NOTIFY_NTFY_URL=
# Only for a self-hosted or access-controlled ntfy server; otherwise leave empty.
NOTIFY_NTFY_TOKEN=
