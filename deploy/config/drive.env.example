# /etc/home-driver/drive.env  (mode 0600, owner root)
# Settings for the Drive web app (home-driver-drive.service).
#
# NOTE FOR CONTRIBUTORS: the authoritative list of DRIVE_* variables is in
# drive/CLAUDE.md. When a variable is added there, add it here with a comment.
#
# Format rules: one KEY=value per line, no spaces around "=", no comments after a value.

# Address Drive listens on. Must stay on 127.0.0.1 (the Cloudflare Tunnel is the
# only way in from outside).
DRIVE_ADDR=127.0.0.1:8090

# SQLite metadata database, on the internal SSD.
DRIVE_DB_PATH=/var/lib/home-driver/drive/drive.db

# Where uploaded files are stored (blobs/ and tmp/), on Disk A.
DRIVE_DATA_DIR=/srv/home-driver/data/drive

# The public address of Drive, exactly as typed in a browser, without a trailing
# slash. Used to build share links and the Google sign-in redirect address.
DRIVE_BASE_URL=https://drive.example.com

# "Sign in with Google" credentials. Create them in the Google Cloud console
# (step-by-step in deploy/docs/INSTALL.md). The redirect URI to register there is
# <DRIVE_BASE_URL>/auth/callback
DRIVE_GOOGLE_CLIENT_ID=
DRIVE_GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails that are administrators (can manage
# users and open the photo curator). At least your own address.
DRIVE_ADMIN_EMAILS=you@gmail.com

# Secret used to sign login sessions. install.sh replaces the placeholder with a
# random value on first install. Changing it later logs everyone out.
DRIVE_SESSION_SECRET=CHANGE_ME_GENERATED_BY_INSTALL

# Where Drive finds the curator, which it serves to administrators at /curator/.
CURATOR_URL=http://127.0.0.1:8091

# Days a deleted file stays in the trash before it is removed for good.
# 0 turns automatic removal off (the trash then only empties by hand).
DRIVE_TRASH_DAYS=30

# DRIVE_DEV_LOGIN exists for development only and lets anyone sign in as any
# email. Never set it on the server. (Drive refuses to start with it unless it
# is bound to localhost with an http://localhost address.)
