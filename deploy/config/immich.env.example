# /etc/home-driver/immich.env  (mode 0600, owner root)
#
# Based on the official example.env of Immich v3.4.2:
#   https://github.com/immich-app/immich/releases/download/v3.4.2/example.env
# All supported variables: https://docs.immich.app/install/environment-variables
#
# Format rules (the file is read by docker compose, systemd and our bash scripts):
# one KEY=value per line, no spaces around "=", no comments after a value.

# Where Immich stores originals, thumbnails and encoded video: on Disk A.
# Do not change: backups, restore and the "disk not mounted" guards rely on it.
UPLOAD_LOCATION=/srv/home-driver/data/immich

# Where the Postgres database files live: on the internal SSD (fast, and safe
# from a USB disk dropping out). Do not point this at a USB disk.
DB_DATA_LOCATION=/var/lib/home-driver/immich-postgres

# OPTIONAL: thumbnails on the SSD. Only used if you also uncomment the matching
# volume block in /opt/home-driver/immich/docker-compose.yml (read the note there).
# THUMB_LOCATION=/var/lib/home-driver/immich-thumbs

# Timezone, from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TZ=Asia/Ho_Chi_Minh

# The Immich version. ALWAYS an exact version, never "release" or "v3": an
# unattended upgrade of a photo database is how libraries get broken.
# To upgrade, follow "Upgrading Immich" in deploy/docs/RUNBOOK.md.
IMMICH_VERSION=v3.4.2

# Password for the Postgres database (only reachable inside Docker's private
# network). install.sh replaces the placeholder with a random value on first
# install. Only characters A-Za-z0-9. Do not change it after the first start.
DB_PASSWORD=CHANGE_ME_GENERATED_BY_INSTALL

# OPTIONAL: also publish Immich on this laptop's private home-network address, so
# the phone app can upload big videos over home Wi-Fi without going through
# Cloudflare (free plan limit: ~100 MB per request). Must be a private address
# such as 192.168.1.50, and the router should always give the laptop that same
# address (DHCP reservation). Leave empty to keep Immich on 127.0.0.1 only.
# See deploy/docs/INSTALL.md, "Large videos".
IMMICH_LAN_ADDR=

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
